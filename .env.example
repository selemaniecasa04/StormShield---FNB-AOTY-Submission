# Postgres (Neon free tier recommended). Leave empty to use the built-in PGlite database.
DATABASE_URL=
# Long random string used to sign session cookies. REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Contact string sent to OpenStreetMap Nominatim when geocoding addresses.
GEOCODER_CONTACT=stormshield-demo@example.com
# Shared secret a real USSD gateway sends in the x-ussd-secret header (16+ characters). Without it, /api/ussd only serves demo numbers.
USSD_SHARED_SECRET=
# Set to "off" to disable the on-screen feature-phone simulator (demo numbers) in production.
PHONE_SIMULATOR=
